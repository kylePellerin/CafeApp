        </div>
        <div class="item">
          <span class="item-name">Café Au Lait</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$3.00<span class="sep">|</span><span class="size">Lg</span>$3.50</span>
        </div>
        <div class="item">
          <span class="item-name">Hot Chocolate</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$1.75<span class="sep">|</span><span class="size">Lg</span>$2.50</span>
        </div>
        <div class="item">
          <span class="item-name">London Fog Latte</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$2.00<span class="sep">|</span><span class="size">Lg</span>$3.00</span>
        </div>
        <div class="item">
          <span class="item-name">Iced London Fog</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$2.50<span class="sep">|</span><span class="size">Lg</span>$3.25</span>
        </div>
        <div class="item">
          <span class="item-name">Hot Tea</span>
          <span class="item-dots"></span>
          <span class="item-price single">$2.00</span>
        </div>
        <div class="item">
          <span class="item-name">Iced Tea</span>
          <span class="item-dots"></span>
          <span class="item-price single">$2.50</span>
        </div>
      </div>

      <div class="section-divider">· · ·</div>

      <!-- Hot Espresso -->
      <div class="section">
        <div class="section-title">Hot Espresso</div>
        <div class="item">
          <span class="item-name">Espresso Shot</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$1.00<span class="sep">|</span><span class="size">Lg</span>$2.00</span>
        </div>
        <div class="item">
          <span class="item-name">Americano</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$2.50<span class="sep">|</span><span class="size">Lg</span>$3.00</span>
        </div>
        <div class="item">
          <span class="item-name">Latte</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$4.00<span class="sep">|</span><span class="size">Lg</span>$4.50</span>
        </div>
        <div class="item">
          <span class="item-name">Cappuccino</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$4.00<span class="sep">|</span><span class="size">Lg</span>$4.50</span>
        </div>
        <div class="item">
          <span class="item-name">Mocha Latte</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$4.50<span class="sep">|</span><span class="size">Lg</span>$5.50</span>
        </div>
      </div>

      <div class="section-divider">· · ·</div>

      <!-- Iced Espresso -->
      <div class="section">
        <div class="section-title">Iced Espresso</div>
        <div class="item">
          <span class="item-name">Americano</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$3.00<span class="sep">|</span><span class="size">Lg</span>$3.50</span>
        </div>
        <div class="item">
          <span class="item-name">Latte</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$4.50<span class="sep">|</span><span class="size">Lg</span>$5.00</span>
        </div>
        <div class="item">
          <span class="item-name">Mocha Latte</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$4.75<span class="sep">|</span><span class="size">Lg</span>$5.75</span>
        </div>
