        <div class="item">
          <span class="item-name">Matcha Latte</span>
          <span class="item-dots"></span>
          <span class="item-price"><span class="size">Sm</span>$4.00<span class="sep">|</span><span class="size">Lg</span>$5.50</span>
        </div>
        <div class="item">
          <span class="item-name">Iced Matcha Latte</span>
          <span class="item-dots"></span>
