<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Bowdoin Cafe Menu</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --cream: #f5f0e8;
      --dark: #2b1d0e;
      --brown: #6b3f1f;
      --gold: #c9a84c;
      --light-brown: #9e6b3e;
      --divider: #d9c9a8;
      --green: #4a7c59;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: var(--cream);
      color: var(--dark);
      font-family: 'Lato', sans-serif;
      font-weight: 300;
      min-height: 100vh;
      padding: 2rem 1rem 8rem;
    }

    .page {
      max-width: 680px;
      margin: 0 auto;
      background: var(--cream);
      position: relative;
    }

    .border-frame {
      border: 2px solid var(--brown);
      padding: 2.5rem 2.5rem 3rem;
      position: relative;
    }

    .border-frame::before {
      content: '';
      position: absolute;
      inset: 6px;
      border: 1px solid var(--gold);
      pointer-events: none;
    }

    .corner {
      position: absolute;
      width: 24px; height: 24px;
      border-color: var(--gold);
      border-style: solid;
    }
    .corner-tl { top: 3px; left: 3px;   border-width: 2px 0 0 2px; }
    .corner-tr { top: 3px; right: 3px;  border-width: 2px 2px 0 0; }
    .corner-bl { bottom: 3px; left: 3px;  border-width: 0 0 2px 2px; }
    .corner-br { bottom: 3px; right: 3px; border-width: 0 2px 2px 0; }

    .header { text-align: center; margin-bottom: 2rem; }

    .header-ornament {
      font-size: 1.2rem; color: var(--gold);
      letter-spacing: 0.5em; display: block; margin-bottom: 0.5rem;
    }

    .menu-title {
      font-family: 'Playfair Display', serif;
      font-size: 2.8rem; font-weight: 700;
      color: var(--brown); letter-spacing: 0.04em; line-height: 1.1;
    }
    .menu-title em { font-style: italic; color: var(--light-brown); }

    .header-rule {
      display: flex; align-items: center; gap: 0.75rem; margin: 1.2rem 0 0;
    }
    .header-rule span {
      flex: 1; height: 1px;
      background: linear-gradient(to right, transparent, var(--gold), transparent);
    }
    .header-rule .diamond {
      width: 8px; height: 8px; background: var(--gold);
      transform: rotate(45deg); flex-shrink: 0;
    }

    .section { margin-bottom: 2rem; }

    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.25rem; font-weight: 700; color: var(--brown);
      letter-spacing: 0.06em; text-transform: uppercase;
      margin-bottom: 0.6rem; padding-bottom: 0.4rem;
      border-bottom: 1px solid var(--divider);
      display: flex; align-items: center; gap: 0.5rem;
    }
    .section-title::before { content: '✦'; color: var(--gold); font-size: 0.7rem; }

    /* Item */
    .item { padding: 0.45rem 0; }

    .item-row {
      display: flex; align-items: center; gap: 0.5rem;
    }

    .item-name {
      font-size: 0.92rem; color: var(--dark);
      letter-spacing: 0.02em; flex-shrink: 0;
    }

    .item-dots {
      flex: 1; border-bottom: 1px dotted var(--divider);
      position: relative; top: -1px;
    }

    .item-price {
      font-size: 0.88rem; color: var(--brown);
      white-space: nowrap; font-weight: 400; flex-shrink: 0;
    }
    .item-price .size { color: var(--light-brown); font-size: 0.78rem; margin-right: 0.15rem; }
    .item-price .sep  { color: var(--divider); margin: 0 0.3rem; }

    /* Order controls */
    .order-controls {
      display: flex; align-items: center; gap: 0.4rem;
      margin-top: 0.35rem; flex-wrap: wrap;
    }

    .size-btn {
      font-family: 'Lato', sans-serif; font-size: 0.72rem;
      font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      padding: 0.22rem 0.6rem;
      border: 1px solid var(--divider); background: transparent;
      color: var(--light-brown); border-radius: 2px; cursor: pointer;
      transition: all 0.15s;
    }
    .size-btn:hover, .size-btn.selected {
      background: var(--brown); color: var(--cream); border-color: var(--brown);
    }

    .add-btn {
      font-family: 'Lato', sans-serif; font-size: 0.72rem;
      font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 0.22rem 0.75rem;
      border: 1px solid var(--green); background: transparent;
      color: var(--green); border-radius: 2px; cursor: pointer;
      transition: all 0.15s;
    }
    .add-btn:hover { background: var(--green); color: white; }
    .add-btn:active { transform: scale(0.96); }

    /* Add-ons */
    .addon {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.25rem 0 0.25rem 1rem;
    }
    .addon-name { font-size: 0.85rem; color: var(--light-brown); font-style: italic; flex-shrink: 0; }
    .addon-dots { flex: 1; border-bottom: 1px dotted var(--divider); position: relative; top: -1px; }
    .addon-price { font-size: 0.85rem; color: var(--brown); flex-shrink: 0; }
    .addon-add-btn {
      font-family: 'Lato', sans-serif; font-size: 0.68rem;
      font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      padding: 0.18rem 0.55rem;
      border: 1px solid var(--green); background: transparent;
      color: var(--green); border-radius: 2px; cursor: pointer;
      transition: all 0.15s; flex-shrink: 0;
    }
    .addon-add-btn:hover { background: var(--green); color: white; }

    .addon-note {
      font-size: 0.78rem; color: var(--light-brown);
      padding-left: 1rem; margin-bottom: 0.2rem; font-style: italic;
    }

    .section-divider {
      text-align: center; color: var(--gold);
      font-size: 0.9rem; letter-spacing: 0.4em; margin: 1.5rem 0;
    }

    .footer {
      text-align: center; margin-top: 2rem;
      padding-top: 1.2rem; border-top: 1px solid var(--divider);
    }
    .footer p {
      font-size: 0.78rem; color: var(--light-brown);
      letter-spacing: 0.08em; text-transform: uppercase;
    }

    /* Cart bar */
    .cart-bar {
      position: fixed; bottom: 0; left: 0; right: 0;
      background: var(--dark); color: var(--cream);
      z-index: 100;
      transform: translateY(100%);
      transition: transform 0.3s ease;
    }
    .cart-bar.visible { transform: translateY(0); }

    .cart-bar-inner {
      max-width: 680px; margin: 0 auto;
      padding: 0.9rem 1.5rem;
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    }

    .cart-summary { font-size: 0.85rem; color: var(--divider); }
    .cart-summary strong { color: var(--cream); font-size: 1rem; }

    .view-order-btn {
      font-family: 'Lato', sans-serif; font-size: 0.78rem;
      font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      padding: 0.5rem 1.2rem;
      border: none; background: var(--gold); color: var(--dark);
      border-radius: 2px; cursor: pointer; transition: opacity 0.15s;
    }
    .view-order-btn:hover { opacity: 0.85; }

    /* Modal */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(43,29,14,0.7);
      z-index: 200; display: none;
      align-items: flex-end; justify-content: center;
    }
    .modal-overlay.open { display: flex; }

    .modal {
      background: var(--cream); width: 100%; max-width: 680px;
      max-height: 85vh; border-radius: 4px 4px 0 0;
      display: flex; flex-direction: column; overflow: hidden;
    }

    .modal-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.2rem 1.5rem 1rem;
      border-bottom: 1px solid var(--divider);
    }
    .modal-title { font-family: 'Playfair Display', serif; font-size: 1.3rem; color: var(--brown); }
    .modal-close { background: none; border: none; font-size: 1.4rem; color: var(--light-brown); cursor: pointer; }

    .modal-body { overflow-y: auto; flex: 1; padding: 1rem 1.5rem; }

    .cart-item {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.6rem 0; border-bottom: 1px dotted var(--divider); gap: 0.75rem;
    }
    .cart-item-info { flex: 1; }
    .cart-item-name { font-size: 0.9rem; color: var(--dark); }
    .cart-item-sub  { font-size: 0.78rem; color: var(--light-brown); margin-top: 0.1rem; }
    .cart-item-price { font-size: 0.9rem; color: var(--brown); font-weight: 400; flex-shrink: 0; }

    .cart-item-qty { display: flex; align-items: center; gap: 0.4rem; flex-shrink: 0; }
    .qty-btn {
      width: 24px; height: 24px;
      border: 1px solid var(--divider); background: transparent;
      color: var(--brown); font-size: 1rem; cursor: pointer; border-radius: 2px;
      display: flex; align-items: center; justify-content: center; transition: background 0.15s;
    }
    .qty-btn:hover { background: var(--divider); }
    .qty-num { font-size: 0.88rem; min-width: 18px; text-align: center; }

    .modal-footer { padding: 1rem 1.5rem 1.5rem; border-top: 1px solid var(--divider); }

    .cart-total {
      display: flex; justify-content: space-between; margin-bottom: 1rem;
      font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--brown);
    }

    .place-order-btn {
      width: 100%; font-family: 'Lato', sans-serif;
      font-size: 0.85rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      padding: 0.85rem; border: none;
      background: var(--brown); color: var(--cream);
      border-radius: 2px; cursor: pointer; transition: background 0.15s;
    }
    .place-order-btn:hover { background: var(--dark); }

    .empty-cart {
      text-align: center; color: var(--light-brown);
      font-style: italic; padding: 2rem 0; font-size: 0.9rem;
    }

    .confirmation { text-align: center; padding: 2rem 1rem; }
    .confirmation .check { font-size: 2.5rem; margin-bottom: 1rem; }
    .confirmation h2 { font-family: 'Playfair Display', serif; color: var(--brown); margin-bottom: 0.5rem; }
    .confirmation p { font-size: 0.85rem; color: var(--light-brown); }

    /* Toast */
    .toast {
      position: fixed; bottom: 80px; left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--green); color: white;
      font-family: 'Lato', sans-serif; font-size: 0.8rem; letter-spacing: 0.06em;
      padding: 0.5rem 1.2rem; border-radius: 20px;
      opacity: 0; transition: all 0.25s;
      pointer-events: none; z-index: 300; white-space: nowrap;
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  </style>
</head>
<body>

<div class="page">
  <div class="border-frame">
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>

    <div class="header">
      <span class="header-ornament">— ✦ —</span>
      <div class="menu-title">Bowdoin <em>Cafe</em></div>
      <div class="menu-title" style="font-size:1.6rem;letter-spacing:0.2em;font-weight:400;margin-top:0.2rem;">MENU</div>
      <div class="header-rule">
        <span></span>
        <div class="diamond"></div>
        <div class="diamond" style="width:5px;height:5px;"></div>
        <div class="diamond"></div>
        <span></span>
      </div>
    </div>

    <!-- Coffee & Tea -->
    <div class="section">
      <div class="section-title">Coffee &amp; Tea</div>
      <% @coffee_and_tea.each do |item| %>
        <div class="item" data-name="<%= item.name %>" 
          <% if item.single_price.present? %>
            data-single="<%= item.single_price %>"
          <% else %>
            data-sm="<%= item.price_sm %>" data-lg="<%= item.price_lg %>"
          <% end %>
        ></div>
      <% end %>
    </div>

    <div class="section-divider">· · ·</div>

    <!-- Hot Espresso -->
    <div class="section">
      <div class="section-title">Hot Espresso</div>
      <% @hot_espresso.each do |item| %>
        <div class="item" data-name="<%= item.name %>" 
          <% if item.single_price.present? %>
            data-single="<%= item.single_price %>"
          <% else %>
            data-sm="<%= item.price_sm %>" data-lg="<%= item.price_lg %>"
          <% end %>
        ></div>
      <% end %>
    </div>

    <div class="section-divider">· · ·</div>

    <!-- Iced Espresso -->
    <div class="section">
      <div class="section-title">Iced Espresso</div>
      <% @iced_espresso.each do |item| %>
        <div class="item" data-name="<%= item.name %>" 
          <% if item.single_price.present? %>
            data-single="<%= item.single_price %>"
          <% else %>
            data-sm="<%= item.price_sm %>" data-lg="<%= item.price_lg %>"
          <% end %>
        ></div>
      <% end %>
    </div>

    <div class="section-divider">· · ·</div>

    <!-- Smoothies -->
    <div class="section">
      <div class="section-title">Smoothies</div>
      <% @smoothies.each do |item| %>
        <div class="item" data-name="<%= item.name %>" 
          <% if item.single_price.present? %>
            data-single="<%= item.single_price %>"
          <% else %>
            data-sm="<%= item.price_sm %>" data-lg="<%= item.price_lg %>"
          <% end %>
        ></div>
      <% end %>
      
      <div class="addon-note">Mango &nbsp;·&nbsp; Strawberry &nbsp;·&nbsp; Peach-Pear Apricot</div>

      <div style="margin-top:0.6rem;padding-top:0.5rem;border-top:1px dashed var(--divider);">
        <% @addons.each do |addon| %>
          <div class="addon">
            <span class="addon-name">+ <%= addon.name %></span>
            <span class="addon-dots"></span>
            <span class="addon-price">$<%= sprintf('%.2f', addon.single_price) %></span>
            <button class="addon-add-btn" onclick="addToCart('<%= addon.name %>', null, <%= addon.single_price %>)">+ Add</button>
          </div>
        <% end %>
        <div class="addon-note">Whey or pea protein</div>
      </div>
    </div>

    <div class="footer">
      <p>Thank you for visiting &nbsp;✦&nbsp; We hope to see you again soon</p>
    </div>
  </div>
</div>

<!-- Cart Bar -->
<div class="cart-bar" id="cartBar">
  <div class="cart-bar-inner">
    <div class="cart-summary">
      <strong id="cartCount">0 items</strong><br>
      <span id="cartBarTotal">$0.00</span>
    </div>
    <button class="view-order-btn" onclick="openModal()">View Order</button>
  </div>
</div>

<!-- Order Modal -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">Your Order</div>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body" id="modalBody"></div>
    <div class="modal-footer" id="modalFooter"></div>
  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script>
  // Build menu items from data attributes
  document.querySelectorAll('.item[data-name]').forEach(el => {
    const name   = el.dataset.name;
    const sm     = el.dataset.sm;
    const lg     = el.dataset.lg;
    const single = el.dataset.single;
    const key    = name.replace(/[^a-zA-Z0-9]/g, '_');

    const priceHTML = single
      ? `<span class="item-price">$${parseFloat(single).toFixed(2)}</span>`
      : `<span class="item-price"><span class="size">Sm</span>$${parseFloat(sm).toFixed(2)}<span class="sep">|</span><span class="size">Lg</span>$${parseFloat(lg).toFixed(2)}</span>`;

    const controls = single
      ? `<button class="add-btn" onclick="addToCart('${name}', null, ${single})">+ Add to Order</button>`
      : `<button class="size-btn" id="sm_${key}" onclick="selectSize(this,'${name}','Sm',${sm},${lg})">Sm $${parseFloat(sm).toFixed(2)}</button>
         <button class="size-btn" id="lg_${key}" onclick="selectSize(this,'${name}','Lg',${sm},${lg})">Lg $${parseFloat(lg).toFixed(2)}</button>
         <button class="add-btn"  id="add_${key}" onclick="addSelected('${name}',${sm},${lg})">+ Add to Order</button>`;

    el.innerHTML = `
      <div class="item-row">
        <span class="item-name">${name}</span>
        <span class="item-dots"></span>
        ${priceHTML}
      </div>
      <div class="order-controls">${controls}</div>`;
  });

  // State
  let cart = [];
  let selectedSizes = {};

  function selectSize(btn, name, size, smP, lgP) {
    selectedSizes[name] = size;
    const key = name.replace(/[^a-zA-Z0-9]/g, '_');
    document.getElementById('sm_' + key).classList.remove('selected');
    document.getElementById('lg_' + key).classList.remove('selected');
    btn.classList.add('selected');
  }

  function addSelected(name, smP, lgP) {
    const size = selectedSizes[name];
    if (!size) { showToast('Choose Sm or Lg first'); return; }
    
    addToCart(name, size, size === 'Sm' ? smP : lgP);

    const key = name.replace(/[^a-zA-Z0-9]/g, '_');
    document.getElementById('sm_' + key).classList.remove('selected');
    document.getElementById('lg_' + key).classList.remove('selected');
    
    delete selectedSizes[name]; 
  }

  function addToCart(name, size, price) {
    const key = name + '|' + (size || '');
    const existing = cart.find(i => i.key === key);
    if (existing) { existing.qty++; }
    else { cart.push({ key, name, size, price: parseFloat(price), qty: 1 }); }
    updateCartBar();
    showToast((size ? size + ' ' : '') + name + ' added!');
  }

  function updateCartBar() {
    const totalQty   = cart.reduce((s, i) => s + i.qty, 0);
    const totalPrice = cart.reduce((s, i) => s + i.price * i.qty, 0);
    document.getElementById('cartCount').textContent    = totalQty + (totalQty === 1 ? ' item' : ' items');
    document.getElementById('cartBarTotal').textContent = '$' + totalPrice.toFixed(2);
    document.getElementById('cartBar').classList.toggle('visible', totalQty > 0);
  }

  function openModal()  { renderModal(); document.getElementById('modalOverlay').classList.add('open'); }
  function closeModal() { document.getElementById('modalOverlay').classList.remove('open'); }

  function renderModal() {
    const body   = document.getElementById('modalBody');
    const footer = document.getElementById('modalFooter');

    if (cart.length === 0) {
      body.innerHTML   = '<div class="empty-cart">Your order is empty.</div>';
      footer.innerHTML = '';
      return;
    }

    body.innerHTML = cart.map((item, idx) => `
      <div class="cart-item">
        <div class="cart-item-info">
          <div class="cart-item-name">${item.name}</div>
          ${item.size ? `<div class="cart-item-sub">${item.size}</div>` : ''}
        </div>
        <div class="cart-item-qty">
          <button class="qty-btn" onclick="changeQty(${idx},-1)">−</button>
          <span class="qty-num">${item.qty}</span>
          <button class="qty-btn" onclick="changeQty(${idx},1)">+</button>
        </div>
        <div class="cart-item-price">$${(item.price * item.qty).toFixed(2)}</div>
      </div>`).join('');

    const total = cart.reduce((s, i) => s + i.price * i.qty, 0);
    footer.innerHTML = `
      <div class="cart-total"><span>Total</span><span>$${total.toFixed(2)}</span></div>
      <button class="place-order-btn" onclick="placeOrder()">Place Order</button>`;
  }

  function changeQty(idx, delta) {
    cart[idx].qty += delta;
    if (cart[idx].qty <= 0) cart.splice(idx, 1);
    updateCartBar();
    if (cart.length === 0) { closeModal(); return; }
    renderModal();
  }

  function placeOrder() {
    document.getElementById('modalBody').innerHTML = `
      <div class="confirmation">
        <div class="check">☕</div>
        <h2>Order Placed!</h2>
        <p>Thank you! Your order is being prepared.<br>We'll have it ready for you shortly.</p>
      </div>`;
    document.getElementById('modalFooter').innerHTML =
      `<button class="place-order-btn" onclick="newOrder()">Start New Order</button>`;
    cart = []; selectedSizes = {};
    updateCartBar();
  }

  function newOrder() {
    closeModal();
    document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('selected'));
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 1800);
  }

  document.getElementById('modalOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
  });
</script>
</body>
</html>