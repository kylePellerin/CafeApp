      <div class="section-divider">· · ·</div>

      <!-- Smoothies -->
      <div class="section">
        <div class="section-title">Smoothies</div>
        <div class="item">
          <span class="item-name">Sunrise Smoothie</span>
          <span class="item-dots"></span>
          <span class="item-price single">$4.50</span>
        </div>
        <div class="item">
          <span class="item-name">Fruit Smoothie</span>
          <span class="item-dots"></span>
          <span class="item-price single">$5.50</span>
        </div>
        <div class="addon-note">Mango &nbsp;·&nbsp; Strawberry &nbsp;·&nbsp; Peach-Pear Apricot</div>

        <div style="margin-top:0.6rem; padding-top:0.5rem; border-top: 1px dashed var(--divider);">
          <div class="addon">
            <span class="addon-name">+ Add Banana</span>
            <span class="addon-price">$1.00</span>
          </div>
          <div class="addon">
            <span class="addon-name">+ Add Protein Powder</span>
            <span class="addon-price">$4.00</span>
          </div>
          <div class="addon-note">Whey or pea protein</div>
        </div>
      </div>

      <div class="footer">
        <p>Thank you for visiting &nbsp;✦&nbsp; We hope to see you again soon</p>
      </div>
    </div>
  </div>
</body>
</html>