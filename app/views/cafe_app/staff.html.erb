<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Staff Dashboard - Bowdoin Cafe</title>
  <meta http-equiv="refresh" content="10">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Lato:wght@400;700&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --cream: #f5f0e8;
      --dark: #2b1d0e;
      --brown: #6b3f1f;
      --gold: #c9a84c;
      --divider: #d9c9a8;
      --green: #4a7c59;
    }
    body {
      background-color: var(--cream);
      color: var(--dark);
      font-family: 'Lato', sans-serif;
      padding: 2rem;
    }
    .header {
      text-align: center;
      margin-bottom: 3rem;
      font-family: 'Playfair Display', serif;
      color: var(--brown);
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.5rem;
    }
    .ticket {
      background: white;
      border: 2px solid var(--brown);
      border-radius: 4px;
      padding: 1.5rem;
      box-shadow: 4px 4px 0px var(--divider);
      display: flex;
      flex-direction: column;
    }
    .ticket-header {
      border-bottom: 2px dashed var(--divider);
      padding-bottom: 0.5rem;
      margin-bottom: 1rem;
    }
    .customer-name {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--brown);
      margin-bottom: 0.2rem;
    }
    .order-id {
      font-size: 0.8rem;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .item-list {
      list-style: none;
      padding: 0;
      margin: 0 0 1.5rem 0;
      flex-grow: 1;
    }
    .item-list li {
      padding: 0.4rem 0;
      border-bottom: 1px solid var(--cream);
      display: flex;
      justify-content: space-between;
    }
    .qty { font-weight: bold; color: var(--brown); margin-right: 0.5rem; }
    .complete-btn {
      width: 100%;
      background: var(--green);
      color: white;
      border: none;
      padding: 0.8rem;
      font-family: 'Lato', sans-serif;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 2px;
      transition: background 0.2s;
    }
    .complete-btn:hover { background: #3a6347; }
    .empty-state { text-align: center; color: var(--brown); font-size: 1.2rem; margin-top: 4rem; }
    
    .notice { background: var(--gold); color: var(--dark); padding: 1rem; text-align: center; margin-bottom: 2rem; border-radius: 4px; font-weight: bold; }
  </style>
</head>
<body>

  <div class="header">
    <h1>Barista Dashboard</h1>
    <p>Active Orders Queue</p>
  </div>

  <% if notice %>
    <div class="notice"><%= notice %></div>
  <% end %>

  <% if @active_orders.empty? %>
    <div class="empty-state">
      <h2>All caught up! ☕</h2>
      <p>There are no active orders right now. Take a breather!</p>
    </div>
  <% else %>
    <div class="grid">
      <% @active_orders.each do |order| %>
        <div class="ticket">
          <div class="ticket-header">
            <div class="customer-name"><%= order.customer_name %></div>
            <div class="order-id">Order #<%= order.id %> • Total: $<%= sprintf('%.2f', order.total) %></div>
          </div>
          
          <ul class="item-list">
            <% order.order_items.each do |item| %>
              <li>
                <span>
                  <span class="qty"><%= item.quantity %>x</span> 
                  <%= item.size %> <%= item.product.name %>
                  <% if item.notes.present? %>
                    <div style="font-size:0.78rem; color:var(--gold); margin-top:0.2rem;">📝 <%= item.notes %></div>
                  <% end %>
                </span>
              </li>
            <% end %>
          </ul>

          <%= button_to "Mark as Ready", complete_order_path(order), method: :patch, class: "complete-btn" %>
        </div>
      <% end %>
    </div>
  <% end %>

</body>
</html>